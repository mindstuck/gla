# GLA deployment settings — template for .env.
#
#   cp .env.example .env     (.env is gitignored — real keys live there only)
#
# Read by docker-compose.yml. One key per line, no inline comments.

# --- Web -----------------------------------------------------------------
# Host port the nginx frontend is published on. The Cloudflare Tunnel talks to
# the container directly through the compose network, so this only matters for
# direct access (LAN / local testing).
WEB_PORT=80

# --- Database ------------------------------------------------------------
# DB_HOST defaults to the bundled sqlserver service. Point it at an external
# SQL Server to avoid running the amd64-only image under emulation on ARM64.
# The local dev flow (backend/appsettings.Development.json) expects the dev
# password below — keep DB_PASSWORD in sync with it while developing.
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=GLA_dev_Pa55w0rd!
DB_NAME=GlaDb

# Browser origins allowed to call the API directly (cross-origin). Unused
# behind nginx — the app is same-origin there.
CORS_ALLOWED_ORIGIN=http://localhost

# --- Cloudflare Tunnel ---------------------------------------------------
# Create a tunnel in Cloudflare Zero Trust -> Networks -> Tunnels and paste
# its token here; point the tunnel's public hostname at http://frontend:80.
CF_TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARED_TUNNEL_TOKEN
